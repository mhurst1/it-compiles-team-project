<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.DashboardController">

    <!-- NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="navbar">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>

            <children>
                <Label fx:id="navlogo" styleClass="navlogo" text="⬡  CodeBoard"/>

                <Region prefWidth="40"/>

                <Button text="Home" onAction="#goToHome" styleClass="nav-btn"/>
                <Button text="Questions" onAction="#goToQuestions" styleClass="nav-btn, nav-btn-active"/>
                <Button text="Community" onAction="#goToCommunity" styleClass="nav-btn"/>

                <Button fx:id="adminDashboardButton"
                    mnemonicParsing="false"
                    onAction="#goToAdminDashboard"
                    styleClass="nav-btn"
                    text="Admin Dashboard" />


                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="welcomeLabel" text="Name" styleClass="nav-username"/>

                <Button onAction="#goToProfile" styleClass="nav-btn">
                    <graphic>
                        <StackPane alignment="CENTER">
                            <children>
                                <Circle radius="16" styleClass="nav-avatar"/>
                                <Label fx:id="navAvatarLetter" text="J" styleClass="nav-avatar-text"/>
                            </children>
                        </StackPane>
                    </graphic>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <HBox>

            <VBox fx:id="leftSidebar" prefWidth="210" spacing="2" styleClass="left-sidebar">
                <padding><Insets bottom="20" left="16" right="16" top="20" /></padding>

                <Label fx:id="sectionsSidebarTitle" styleClass="sidebar-section-title" text="SECTIONS" />

                <HBox fx:id="sidebarAllQuestions" alignment="CENTER_LEFT" styleClass="sidebar-item, sidebar-item-active">
                    <Label fx:id="sidebarAllQuestionsLabel" styleClass="sidebar-item-label" text="All Questions" HBox.hgrow="ALWAYS" />
                    <Label fx:id="sidebarAllQuestionsCount" styleClass="sidebar-count" text="0" />
                </HBox>
                <VBox fx:id="languageSidebarList" spacing="2" />
            </VBox>

            <VBox fx:id="mainContent" spacing="14" styleClass="main-content" HBox.hgrow="ALWAYS">
                <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>

                <TextField fx:id="searchField" promptText="Search questions..." styleClass="search-field" />

                <Label fx:id="welcomeGreeting" styleClass="welcome-greeting" />

                <HBox fx:id="filterBar" alignment="CENTER_LEFT" spacing="10">
                    <VBox fx:id="questionListHeader" spacing="2">
                        <Label fx:id="contentTitle" styleClass="content-title" text="All Questions" />
                        <Label fx:id="contentSubtitle" styleClass="content-subtitle" text="0 questions across all topics" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="filterAllBtn" mnemonicParsing="false" onAction="#filterAll" styleClass="filter-btn, filter-btn-active" text="All" />
                    <Button fx:id="filterEasyBtn" mnemonicParsing="false" onAction="#filterEasy" styleClass="filter-btn" text="Easy" />
                    <Button fx:id="filterMediumBtn" mnemonicParsing="false" onAction="#filterMedium" styleClass="filter-btn" text="Medium" />
                    <Button fx:id="filterHardBtn" mnemonicParsing="false" onAction="#filterHard" styleClass="filter-btn" text="Hard" />
                    <Button fx:id="filterStarredBtn" mnemonicParsing="false" onAction="#filterStarred" styleClass="filter-btn" text="⭐ Starred" />
                    <Button fx:id="addQuestionBtn" mnemonicParsing="false" onAction="#goToAddQuestion" styleClass="add-btn" text="+" />
                </HBox>

                <ScrollPane fx:id="cardScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS">
                    <VBox fx:id="questionCardList" spacing="8">
                        <padding><Insets bottom="4" left="0" right="0" top="4" /></padding>
                    </VBox>
                </ScrollPane>

            </VBox>

            <VBox fx:id="rightSidebar" prefWidth="230" spacing="10" styleClass="right-sidebar">
                <padding><Insets bottom="20" left="16" right="16" top="20" /></padding>

                <Label fx:id="quickStatsTitle" styleClass="sidebar-section-title" text="QUICK STATS" />

                <VBox fx:id="statCardSolved" spacing="4" styleClass="stat-card">
                    <Label fx:id="statSolvedLabel" styleClass="stat-label" text="Questions Solved" />
                    <Label fx:id="statSolvedValue" styleClass="stat-value" text="0" />
                </VBox>

                <VBox fx:id="statCardStreak" spacing="4" styleClass="stat-card">
                    <Label fx:id="statStreakLabel" styleClass="stat-label" text="Current Streak" />
                    <Label fx:id="statStreakValue" styleClass="stat-value, stat-streak" text="0 days" />
                </VBox>

                <VBox fx:id="statCardRank" spacing="4" styleClass="stat-card">
                    <Label fx:id="statRankLabel" styleClass="stat-label" text="Rank" />
                    <Label fx:id="statRankValue" styleClass="stat-value, stat-rank" text="#N/A" />
                </VBox>

                <VBox fx:id="statCardUpvotes" spacing="4" styleClass="stat-card">
                    <Label fx:id="statUpvoteLabel" styleClass="stat-label" text="Vote Points" />
                    <Label fx:id="statUpvoteValue" styleClass="stat-value, stat-upvote" text="0" />
                </VBox>

                <VBox fx:id="recentActivityCard" spacing="6" styleClass="stat-card">
                    <Label fx:id="recentActivityTitle" styleClass="sidebar-section-title" text="RECENT ACTIVITY" />
                    <VBox fx:id="recentActivityList" spacing="4" />
                </VBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>
