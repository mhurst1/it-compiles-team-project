<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@dashboard.css"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.ContributorApplicationController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="navbar">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>
            <children>
                <Label fx:id="navlogo" styleClass="navlogo" text="CodeBoard"/>
                <Region prefWidth="40"/>
                <Button text="Home" onAction="#goToHome" styleClass="nav-btn"/>
                <Button text="Questions" onAction="#goToQuestions" styleClass="nav-btn"/>
                <Button text="Community" onAction="#goToCommunity" styleClass="nav-btn"/>

                <Button fx:id="contributorApplicationButton"
                        managed="false"
                        mnemonicParsing="false"
                        onAction="#goToContributorApplication"
                        styleClass="nav-btn, nav-btn-active"
                        text="Contributor Application"
                        visible="false" />

                <Button fx:id="adminDashboardButton"
                        managed="false"
                        mnemonicParsing="false"
                        onAction="#goToAdminDashboard"
                        styleClass="nav-btn"
                        text="Admin Dashboard"
                        visible="false" />

                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeLabel" text="Name" styleClass="nav-username"/>
                <Button onAction="#goToProfile" styleClass="nav-btn">
                    <graphic>
                        <StackPane alignment="CENTER">
                            <children>
                                <Circle radius="16" styleClass="nav-avatar"/>
                                <Label fx:id="navAvatarLetter" text="U" styleClass="nav-avatar-text"/>
                            </children>
                        </StackPane>
                    </graphic>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <content>
                <VBox alignment="TOP_CENTER" spacing="18" styleClass="main-content">
                    <padding>
                        <Insets top="36" right="24" bottom="36" left="24"/>
                    </padding>

                    <VBox spacing="4" maxWidth="720">
                        <Label styleClass="content-title" text="Contributor Application"/>
                        <Label styleClass="content-subtitle"
                               text="Apply for access to add and maintain interview questions."/>
                    </VBox>

                    <VBox fx:id="formCard" spacing="14" maxWidth="720" styleClass="application-card">
                        <padding>
                            <Insets top="24" right="24" bottom="24" left="24"/>
                        </padding>
                        <children>
                            <VBox spacing="3">
                                <Label fx:id="applicantNameLabel" styleClass="application-name" text="Applicant"/>
                                <Label fx:id="applicantRoleLabel" styleClass="content-subtitle" text="Current role: USER"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label styleClass="stat-label" text="Experience"/>
                                <TextField fx:id="experienceField"
                                           promptText="Classes, projects, languages, or topics you can help with"
                                           styleClass="search-field"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label styleClass="stat-label" text="Why do you want to contribute?"/>
                                <TextArea fx:id="motivationField"
                                          prefRowCount="7"
                                          wrapText="true"
                                          promptText="Describe how you would improve the question bank."
                                          styleClass="application-textarea"/>
                            </VBox>

                            <Label fx:id="feedbackLabel" styleClass="content-subtitle" text=""/>

                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Button text="Back" onAction="#goToHome" styleClass="filter-btn"/>
                                <Button fx:id="submitButton"
                                        text="Submit Application"
                                        onAction="#submitApplication"
                                        styleClass="add-btn"/>
                            </HBox>
                        </children>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
