<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@browsesolutions.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.BrowseSolutions">

    <!-- NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="navbar">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>

            <children>
                <Label fx:id="navlogo" styleClass="navlogo" text="⬡  CodeBoard"/>

                <Region prefWidth="40"/>

                <Button text="Home" onAction="#goToHome" styleClass="nav-btn"/>
                <Button text="Questions" onAction="#goToQuestions" styleClass="nav-btn"/>
                <Button text="Community" onAction="#goToCommunity" styleClass="nav-btn"/>

                <Button fx:id="adminDashboardButton"
                    mnemonicParsing="false"
                    onAction="#goToAdminDashboard"
                    styleClass="nav-btn"
                    text="Admin Dashboard" />


                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="navUsername" text="Name" styleClass="nav-username"/>

                <Button onAction="#goToProfile" styleClass="nav-btn">
                    <graphic>
                        <StackPane alignment="CENTER">
                            <children>
                                <Circle radius="16" styleClass="nav-avatar"/>
                                <Label fx:id="navAvatarLetter" text="J" styleClass="nav-avatar-text"/>
                            </children>
                        </StackPane>
                    </graphic>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <HBox>

            <ScrollPane fitToWidth="true" prefWidth="540" styleClass="left-scroll" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <VBox spacing="16" styleClass="left-panel">
                    <padding><Insets bottom="32" left="28" right="28" top="20" /></padding>

                    <Button mnemonicParsing="false" styleClass="back-link"
                            text="Back to Questions" onAction="#goBack" />

                    <Label fx:id="questionTitle" styleClass="question-page-title" text="" wrapText="true" />

                   <VBox spacing="6">

                    <HBox alignment="CENTER_LEFT" spacing="10">

                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label fx:id="starLabel" text="☆" styleClass="star-label" onMouseClicked="#toggleStar"/>
                            <Label fx:id="languageBadge" styleClass="badge badge-language"/>
                            <Label fx:id="difficultyBadge" styleClass="diff-badge"/>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="authorLabel" styleClass="question-author"/>
                        </HBox>

                        <Label fx:id="answersLabel" styleClass="answers-label"/>

                    </VBox>

                    <VBox styleClass="description-box">
                        <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>
                        <Label fx:id="questionDescription" styleClass="description-text"
                               text="" wrapText="true" />
                    </VBox>

                    <Label styleClass="submit-heading" text="Submit Solution" />
                    <TextArea fx:id="solutionInput" styleClass="code-editor"
                              promptText="Write your solution here..." wrapText="true" prefRowCount="7" />

                    <Button mnemonicParsing="false" styleClass="post-solution-btn"
                            text="Post Solution" onAction="#postSolution" maxWidth="Infinity" />
                </VBox>
            </ScrollPane>

            <VBox HBox.hgrow="ALWAYS" styleClass="right-panel">
                <padding><Insets bottom="20" left="20" right="24" top="20" /></padding>
                <Label styleClass="community-heading" text="Community Solutions" />
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="solutions-scroll" hbarPolicy="NEVER">
                    <VBox fx:id="solutionsContainer" spacing="14">
                        <padding><Insets top="12" bottom="12" right="4" /></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

        </HBox>
    </center>

</BorderPane>
