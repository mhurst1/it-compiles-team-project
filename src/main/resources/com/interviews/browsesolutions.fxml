<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@browsesolutions.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.BrowseSolutions">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="navbar">
            <padding><Insets bottom="12" left="24" right="24" top="12" /></padding>
            <Label styleClass="nav-logo" text="⬡  CodeBoard" />
            <Region prefWidth="40" />
            <Button mnemonicParsing="false" onAction="#goBack" styleClass="nav-btn" text="Home" />
            <Button mnemonicParsing="false" onAction="#goBack" styleClass="nav-btn, nav-btn-active" text="Questions" />
            <Button mnemonicParsing="false" onAction="#goToCommunity" styleClass="nav-btn" text="Community" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="navUsername" styleClass="nav-username" text="" />
            <Circle radius="16" styleClass="nav-avatar" />
        </HBox>
    </top>

    <center>
        <HBox>

            <ScrollPane fitToWidth="true" prefWidth="540" styleClass="left-scroll" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <VBox spacing="16" styleClass="left-panel">
                    <padding><Insets bottom="32" left="28" right="28" top="20" /></padding>

                    <Button mnemonicParsing="false" styleClass="back-link"
                            text="Back to Questions" onAction="#goBack" />

                    <Label fx:id="questionTitle" styleClass="question-page-title" text="" wrapText="true" />

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="categoryBadge" styleClass="cat-badge" text="" />
                        <Label fx:id="difficultyBadge" styleClass="diff-badge" text="" />
                        <Label fx:id="answersLabel" styleClass="answers-label" text="" />
                    </HBox>

                    <VBox styleClass="description-box">
                        <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>
                        <Label fx:id="questionDescription" styleClass="description-text"
                               text="" wrapText="true" />
                    </VBox>

                    <Label styleClass="submit-heading" text="Submit Solution" />
                    <TextArea fx:id="solutionInput" styleClass="code-editor"
                              promptText="Write your solution here..." wrapText="true" prefRowCount="7" />

                    <Button mnemonicParsing="false" styleClass="post-solution-btn"
                            text="Post Solution" onAction="#postSolution" maxWidth="Infinity" />
                </VBox>
            </ScrollPane>

            <VBox HBox.hgrow="ALWAYS" styleClass="right-panel">
                <padding><Insets bottom="20" left="20" right="24" top="20" /></padding>
                <Label styleClass="community-heading" text="Community Solutions" />
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="solutions-scroll" hbarPolicy="NEVER">
                    <VBox fx:id="solutionsContainer" spacing="14">
                        <padding><Insets top="12" bottom="12" right="4" /></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

        </HBox>
    </center>

</BorderPane>
