<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="619.0" prefWidth="905.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.LoginController">
    <children>
        <Label text="Login View" />
      <Label text="Username" />
      <TextField fx:id="txt_username" />
      <Label text="Password" />
      <TextField fx:id="txt_password" />
        <Button fx:id="loginButton" onAction="#goToHome" text="Back" />
      <Button mnemonicParsing="false" onAction="#login" text="Login" />
      <Label fx:id="errorLabel" style="-fx-text-fill: red;" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
