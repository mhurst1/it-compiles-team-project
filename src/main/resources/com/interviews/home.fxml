<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="700.0" prefWidth="974.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.HomeController">

   <children>
      <HBox fillHeight="true" maxWidth="Infinity" spacing="40.0">
         <children>

            <!-- LEFT SIDE -->
            <VBox maxWidth="Infinity" spacing="15.0" HBox.hgrow="ALWAYS">
               <children>
                  <Text fx:id="homePageTitle1" text="Ace Your" />
                  <Text fx:id="homePageTitle2" text="Technical Interview" />
                  <Text fx:id="homePageSubtitle" text="Practice real question, join the community, and track your progress." />

                  <VBox spacing="8.0">
                     <children>
                        <Label fx:id="bullet1" text="✦ 100+ curated inteview questions" />
                        <Label fx:id="bullet2" text="✦ Community solution discussions" />
                        <Label fx:id="bullet3" text="✦ Progress tracking by section" />
                     </children>
                  </VBox>
               </children>
            </VBox>

            <!-- RIGHT SIDE -->
            <VBox maxWidth="Infinity" spacing="15.0" styleClass="login-box" HBox.hgrow="ALWAYS">
               <children>

                  <!-- ADD ACTUAL LOGO HERE AND REPLACE OCTOGON -->
                  <Label fx:id="codeBoardName" text="⬡  CodeBoard" />
                  <Text fx:id="signInTitle" text="Sign In" />
                  <Text fx:id="signInSub" text="Welcome back — continue where you left off." />

                  <VBox spacing="6.0">
                     <children>
                        <Label fx:id="usernameTitle" text="Username" />
                        <TextField fx:id="username_txt" promptText="Enter your username" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0">
                     <children>
                        <HBox>
                           <children>
                              <Label fx:id="passwordTitle" text="Password" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="forgotPassBtn" onAction="#forgotPassword" text="Forgot Password?" />
                           </children>
                        </HBox>
                        <TextField fx:id="password_txt" promptText="Enter your password" />
                     </children>
                  </VBox>

                  <HBox alignment="CENTER" prefHeight="35.0" prefWidth="148.0">
                     <children>
                        <Button fx:id="homeButton" onAction="#goToLogin" text="Log In" />
                     </children>
                  </HBox>

                  <HBox alignment="CENTER">
                     <children>
                        <Text fx:id="orDivider" text="or" />
                     </children>
                  </HBox>

                  <HBox alignment="CENTER" spacing="4.0">
                     <children>
                        <Text fx:id="signUpHint" text="Don't have an account?" />
                        <Button fx:id="signUpBtn" onAction="#signUp" text="Sign up" />
                     </children>
                  </HBox>

                  <Button fx:id="continueBtn" maxWidth="Infinity" onAction="#continueWithoutLogin" text="Continue without logging in" />

               </children>
            </VBox>

         </children>
      </HBox>
   </children>

   <padding>
      <Insets bottom="20.0" left="80.0" right="80.0" top="20.0" />
   </padding>

   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</VBox>
