<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.DashboardController">

    <top>
        <HBox fx:id="navbar" alignment="CENTER_LEFT" spacing="16" styleClass="navbar">
            <padding><Insets bottom="12" left="24" right="24" top="12" /></padding>

            <Label fx:id="navLogo" styleClass="nav-logo" text="⬡  CodeBoard" />

            <Region prefWidth="40" />

            <Button fx:id="navHomeBtn" mnemonicParsing="false" styleClass="nav-btn" text="Home" />
            <Button fx:id="navQuestionsBtn" mnemonicParsing="false" styleClass="nav-btn, nav-btn-active" text="Questions" />
            <Button fx:id="navCommunityBtn" mnemonicParsing="false" styleClass="nav-btn" text="Community" />

            <Region prefHeight="34.0" prefWidth="447.0" HBox.hgrow="ALWAYS" />

            <Label fx:id="welcomeLabel" styleClass="nav-username" text="Name" />
            <Circle fx:id="navAvatar" radius="16" styleClass="nav-avatar" />
        </HBox>
    </top>

    <center>
        <HBox>

            <VBox fx:id="leftSidebar" prefWidth="210" spacing="2" styleClass="left-sidebar">
                <padding><Insets bottom="20" left="16" right="16" top="20" /></padding>

                <Label fx:id="sectionsSidebarTitle" styleClass="sidebar-section-title" text="SECTIONS" />

                <HBox fx:id="sidebarAllQuestions" alignment="CENTER_LEFT" styleClass="sidebar-item, sidebar-item-active">
                    <Label fx:id="sidebarAllQuestionsLabel" styleClass="sidebar-item-label" text="All Questions" HBox.hgrow="ALWAYS" />
                    <Label fx:id="sidebarAllQuestionsCount" styleClass="sidebar-count" text="0" />
                </HBox>
                <HBox fx:id="sidebarArrays" alignment="CENTER_LEFT" styleClass="sidebar-item">
                    <Label fx:id="sidebarArraysLabel" styleClass="sidebar-item-label" text="Arrays &amp; Strings" HBox.hgrow="ALWAYS" />
                    <Label fx:id="sidebarArraysCount" styleClass="sidebar-count" text="0" />
                </HBox>
                <HBox fx:id="sidebarTrees" alignment="CENTER_LEFT" styleClass="sidebar-item">
                    <Label fx:id="sidebarTreesLabel" styleClass="sidebar-item-label" text="Trees &amp; Graphs" HBox.hgrow="ALWAYS" />
                    <Label fx:id="sidebarTreesCount" styleClass="sidebar-count" text="0" />
                </HBox>
                <HBox fx:id="sidebarDP" alignment="CENTER_LEFT" styleClass="sidebar-item">
                    <Label fx:id="sidebarDPLabel" styleClass="sidebar-item-label" text="Dynamic Programming" HBox.hgrow="ALWAYS" />
                    <Label fx:id="sidebarDPCount" styleClass="sidebar-count" text="0" />
                </HBox>
                <HBox fx:id="sidebarSearchSort" alignment="CENTER_LEFT" styleClass="sidebar-item">
                    <Label fx:id="sidebarSearchSortLabel" styleClass="sidebar-item-label" text="Searching &amp; Sorting" HBox.hgrow="ALWAYS" />
                    <Label fx:id="sidebarSearchSortCount" styleClass="sidebar-count" text="0" />
                </HBox>
                <HBox fx:id="sidebarStacks" alignment="CENTER_LEFT" styleClass="sidebar-item">
                    <Label fx:id="sidebarStacksLabel" styleClass="sidebar-item-label" text="Stacks &amp; Queues" HBox.hgrow="ALWAYS" />
                    <Label fx:id="sidebarStacksCount" styleClass="sidebar-count" text="0" />
                </HBox>
                <HBox fx:id="sidebarLinkedLists" alignment="CENTER_LEFT" styleClass="sidebar-item">
                    <Label fx:id="sidebarLinkedListsLabel" styleClass="sidebar-item-label" text="Linked Lists" HBox.hgrow="ALWAYS" />
                    <Label fx:id="sidebarLinkedListsCount" styleClass="sidebar-count" text="0" />
                </HBox>
                <HBox fx:id="sidebarSystemDesign" alignment="CENTER_LEFT" styleClass="sidebar-item">
                    <Label fx:id="sidebarSystemDesignLabel" styleClass="sidebar-item-label" text="System Design" HBox.hgrow="ALWAYS" />
                    <Label fx:id="sidebarSystemDesignCount" styleClass="sidebar-count" text="0" />
                </HBox>
                <HBox fx:id="sidebarOOP" alignment="CENTER_LEFT" styleClass="sidebar-item">
                    <Label fx:id="sidebarOOPLabel" styleClass="sidebar-item-label" text="OOP Concepts" HBox.hgrow="ALWAYS" />
                    <Label fx:id="sidebarOOPCount" styleClass="sidebar-count" text="0" />
                </HBox>
                <HBox fx:id="sidebarDatabases" alignment="CENTER_LEFT" styleClass="sidebar-item">
                    <Label fx:id="sidebarDatabasesLabel" styleClass="sidebar-item-label" text="Databases" HBox.hgrow="ALWAYS" />
                    <Label fx:id="sidebarDatabasesCount" styleClass="sidebar-count" text="0" />
                </HBox>
            </VBox>

            <VBox fx:id="mainContent" spacing="14" styleClass="main-content" HBox.hgrow="ALWAYS">
                <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>

                <TextField fx:id="searchField" promptText="Search questions..." styleClass="search-field" />

                <Label fx:id="welcomeGreeting" styleClass="welcome-greeting" />

                <HBox fx:id="filterBar" alignment="CENTER_LEFT" spacing="10">
                    <VBox fx:id="questionListHeader" spacing="2">
                        <Label fx:id="contentTitle" styleClass="content-title" text="All Questions" />
                        <Label fx:id="contentSubtitle" styleClass="content-subtitle" text="0 questions across all topics" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="filterAllBtn" mnemonicParsing="false" onAction="#filterAll" styleClass="filter-btn, filter-btn-active" text="All" />
                    <Button fx:id="filterEasyBtn" mnemonicParsing="false" onAction="#filterEasy" styleClass="filter-btn" text="Easy" />
                    <Button fx:id="filterMediumBtn" mnemonicParsing="false" onAction="#filterMedium" styleClass="filter-btn" text="Medium" />
                    <Button fx:id="filterHardBtn" mnemonicParsing="false" onAction="#filterHard" styleClass="filter-btn" text="Hard" />
                    <Button fx:id="addQuestionBtn" mnemonicParsing="false" onAction="#goToAddQuestion" styleClass="add-btn" text="+" />
                </HBox>

                <ScrollPane fx:id="cardScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS">
                    <VBox fx:id="questionCardList" spacing="8">
                        <padding><Insets bottom="4" left="0" right="0" top="4" /></padding>
                    </VBox>
                </ScrollPane>

            </VBox>

            <VBox fx:id="rightSidebar" prefWidth="230" spacing="10" styleClass="right-sidebar">
                <padding><Insets bottom="20" left="16" right="16" top="20" /></padding>

                <Label fx:id="quickStatsTitle" styleClass="sidebar-section-title" text="QUICK STATS" />

                <VBox fx:id="statCardSolved" spacing="4" styleClass="stat-card">
                    <Label fx:id="statSolvedLabel" styleClass="stat-label" text="Questions Solved" />
                    <Label fx:id="statSolvedValue" styleClass="stat-value" text="0" />
                </VBox>

                <VBox fx:id="statCardStreak" spacing="4" styleClass="stat-card">
                    <Label fx:id="statStreakLabel" styleClass="stat-label" text="Current Streak" />
                    <Label fx:id="statStreakValue" styleClass="stat-value, stat-streak" text="0 days" />
                </VBox>

                <VBox fx:id="statCardRank" spacing="4" styleClass="stat-card">
                    <Label fx:id="statRankLabel" styleClass="stat-label" text="Rank" />
                    <Label fx:id="statRankValue" styleClass="stat-value, stat-rank" text="#N/A" />
                </VBox>

                <VBox fx:id="statCardUpvotes" spacing="4" styleClass="stat-card">
                    <Label fx:id="statUpvoteLabel" styleClass="stat-label" text="Total Upvotes" />
                    <Label fx:id="statUpvoteValue" styleClass="stat-value, stat-upvote" text="↑ 0" />
                </VBox>

                <VBox fx:id="statCardDownvotes" spacing="4" styleClass="stat-card">
                    <Label fx:id="statDownvoteLabel" styleClass="stat-label" text="Total Downvotes" />
                    <Label fx:id="statDownvoteValue" styleClass="stat-value, stat-downvote" text="↓ 0" />
                </VBox>

                <VBox fx:id="recentActivityCard" spacing="6" styleClass="stat-card">
                    <Label fx:id="recentActivityTitle" styleClass="sidebar-section-title" text="RECENT ACTIVITY" />
                    <Label fx:id="activityItem1" styleClass="activity-item" text="✅ Solved Two Sum" />
                    <Label fx:id="activityItem2" styleClass="activity-item" text="💬 Commented on Merge K..." />
                    <Label fx:id="activityItem3" styleClass="activity-item" text="👁️ Viewed LIS Problem" />
                    <Label fx:id="activityItem4" styleClass="activity-item" text="✅ Solved BT Level Order" />
                    <Label fx:id="activityItem5" styleClass="activity-item" text="Started URL Shortener" />
                </VBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>
