<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="800.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controllers.AddQuestionController">

    <!-- NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="navbar">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>

            <children>
                <Label fx:id="navlogo" styleClass="navlogo" text="⬡  CodeBoard"/>

                <Region prefWidth="40"/>

                <Button text="Home" onAction="#goToHome" styleClass="nav-btn"/>
                <Button text="Questions" onAction="#goToQuestions" styleClass="nav-btn"/>
                <Button text="Community" onAction="#goToCommunity" styleClass="nav-btn"/>

                <Button fx:id="adminDashboardButton"
                    mnemonicParsing="false"
                    onAction="#goToAdminDashboard"
                    styleClass="nav-btn"
                    text="Admin Dashboard" />


                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="welcomeLabel" text="Name" styleClass="nav-username"/>

                <Button onAction="#goToProfile" styleClass="nav-btn">
                    <graphic>
                        <StackPane alignment="CENTER">
                            <children>
                                <Circle radius="16" styleClass="nav-avatar"/>
                            </children>
                        </StackPane>
                    </graphic>
                </Button>
            </children>
        </HBox>
    </top>

   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true">
         <content>
            <VBox fx:id="pageRoot" spacing="0.0">

               <HBox alignment="CENTER_LEFT">
                  <padding><Insets bottom="0.0" left="24.0" right="24.0" top="16.0" /></padding>
                  <Button text="← Back" styleClass="btn-back" onAction="#goToDashboard" />
               </HBox>

               <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                  <padding><Insets bottom="24.0" left="24.0" right="24.0" top="12.0" /></padding>
                  <children>


                     <VBox HBox.hgrow="ALWAYS" spacing="16.0">
                        <children>

                           <VBox fx:id="formCard" spacing="16.0">
                              <padding><Insets bottom="24.0" left="24.0" right="24.0" top="20.0" /></padding>
                              <children>

                                 <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                       <Label fx:id="formTitle" text="Add New Question" styleClass="form-title" />
                                       <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                 </HBox>

                                 <Separator />

                                 <VBox spacing="5.0">
                                    <children>
                                       <Label text="Question Title" styleClass="field-label" />
                                       <TextField fx:id="txt_title" promptText="e.g. Design a Linked List" styleClass="field-input" />
                                    </children>
                                 </VBox>

                                 <HBox spacing="16.0">
                                    <children>
                                       <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                          <children>
                                             <Label text="LANGUAGE" styleClass="field-label" />
                                             <ComboBox fx:id="cb_language" promptText="Select a language" maxWidth="Infinity" />
                                          </children>
                                       </VBox>
                                       <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                          <children>
                                             <Label text="Difficulty" styleClass="field-label" />
                                             <ComboBox fx:id="cb_difficulty" promptText="Select difficulty" maxWidth="Infinity" />
                                          </children>
                                       </VBox>
                                    </children>
                                 </HBox>

                                 <VBox spacing="5.0">
                                    <children>
                                       <Label text="Problem Description" styleClass="field-label" />
                                       <TextArea fx:id="txt_description"
                                                 promptText="Description, examples, constraints, etc."
                                                 prefRowCount="5"
                                                 wrapText="true"
                                                 styleClass="field-textarea" />
                                    </children>
                                 </VBox>

                                 <VBox spacing="8.0">
                                    <children>
                                       <Label text="Add Hints" styleClass="field-label" />
                                       <HBox spacing="8.0" alignment="CENTER_LEFT">
                                          <children>
                                             <TextField fx:id="txt_hint1" promptText="Hint 1" HBox.hgrow="ALWAYS" styleClass="field-input" />
                                             <Button fx:id="removeHint1Btn" text="✕" styleClass="btn-remove-hint" onAction="#removeHint1" />
                                          </children>
                                       </HBox>
                                       <HBox spacing="8.0" alignment="CENTER_LEFT">
                                          <children>
                                             <TextField fx:id="txt_hint2" promptText="Hint 2" HBox.hgrow="ALWAYS" styleClass="field-input" />
                                             <Button fx:id="removeHint2Btn" text="✕" styleClass="btn-remove-hint" onAction="#removeHint2" />
                                          </children>
                                       </HBox>
                                       <HBox fx:id="hint3Row" spacing="8.0" alignment="CENTER_LEFT" managed="false" visible="false">
                                          <children>
                                             <TextField fx:id="txt_hint3" promptText="Hint 3" HBox.hgrow="ALWAYS" styleClass="field-input" />
                                             <Button fx:id="removeHint3Btn" text="✕" styleClass="btn-remove-hint" onAction="#removeHint3" />
                                          </children>
                                       </HBox>
                                       <Button fx:id="addHintBtn" text="+ Add Hint" styleClass="btn-ghost" onAction="#addHint" />
                                    </children>
                                 </VBox>

                                 <Button fx:id="addAttachmentBtn" text="+ Add Attachment" styleClass="btn-ghost" onAction="#addAttachment" maxWidth="Infinity" />

                                 <Label fx:id="attachmentLabel" text="" styleClass="attachment-label" />

                                 <Label fx:id="feedbackLabel" text="" styleClass="feedback-label" />

                                 <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                       <Region HBox.hgrow="ALWAYS" />
                                       <Button fx:id="saveDraftBtn" text="Save Draft" styleClass="btn-outline" onAction="#saveDraft" />
                                       <Button fx:id="submitBtn" text="Submit" styleClass="btn-submit" onAction="#submitQuestion" />
                                    </children>
                                 </HBox>

                              </children>
                           </VBox>

                        </children>
                     </VBox>

                  </children>
               </HBox>
            </VBox>
         </content>
      </ScrollPane>
   </center>

   <stylesheets>
      <URL value="@addquestion.css" />
   </stylesheets>

</BorderPane>
